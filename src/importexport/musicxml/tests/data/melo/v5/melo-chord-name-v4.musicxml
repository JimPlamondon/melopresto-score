<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="4.0" xmlns:melo="urn:melopresto:musicxml:5">
  <work><work-title>JiMS chord names on a MeloStaff beside conventional harmony</work-title></work>
  <melo:reference-timeline><melo:initial-pitch step="D" alter="0" octave="4" /></melo:reference-timeline>
  <part-list>
    <score-part id="P1"><part-name>JiMS chord names (MeloStaff)</part-name></score-part>
    <score-part id="P2"><part-name>Conventional chords (stock staff)</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>4</divisions>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <melo:staff-state>
          <melo:scale>
            <melo:step>M2</melo:step><melo:step>m2</melo:step><melo:step>M2</melo:step>
            <melo:step>M2</melo:step><melo:step>M2</melo:step><melo:step>m2</melo:step>
            <melo:step>M2</melo:step>
          </melo:scale>
          <melo:collection-rotation>0</melo:collection-rotation>
          <melo:mode-rotation>0</melo:mode-rotation>
          <melo:generator-cents>700.0</melo:generator-cents>
          <melo:period-cents>1200.0</melo:period-cents>
          <melo:embedding large-steps="5" small-steps="2"/>
          <melo:extent lower-n-per="1" lower-n-gen="-2" upper-n-per="2" upper-n-gen="-2"/>
          <melo:tonic-ambit>tonic-bounded</melo:tonic-ambit>
          
        </melo:staff-state>
      </attributes>
      <harmony placement="above"><melo:chord-name>!So7/3</melo:chord-name><staff>1</staff></harmony>
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
        <melo:pitch n-per="1" n-gen="-2"/>
        <duration>16</duration><type>whole</type>
      </note>
    </measure>
    <measure number="2">
      <print new-system="yes"/>
      <harmony placement="above"><melo:chord-name>Re:So7</melo:chord-name><staff>1</staff></harmony>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <melo:pitch n-per="2" n-gen="-2"/>
        <duration>16</duration><type>whole</type>
      </note>
    </measure>
  </part>
  <part id="P2">
    <measure number="1">
      <attributes>
        <divisions>4</divisions>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <harmony placement="above"><root><root-step>C</root-step></root><kind>major</kind><staff>1</staff></harmony>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>16</duration><type>whole</type></note>
    </measure>
    <measure number="2">
      <harmony placement="above"><root><root-step>G</root-step></root><kind>major</kind><staff>1</staff></harmony>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>16</duration><type>whole</type></note>
    </measure>
  </part>
</score-partwise>
